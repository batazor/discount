{
  "uid": "discount-promotions",
  "title": "Discount promotions",
  "description": "Per-promotion applications, discount granted, skips by reason and clamping. Source: OpenTelemetry metrics of discount-server.",
  "tags": [
    "discount"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(discount_evaluations_total, deployment_environment)",
          "refId": "env"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Promotions",
      "type": "link",
      "url": "/d/discount-promotions"
    },
    {
      "title": "Validation errors",
      "type": "link",
      "url": "/d/discount-validation-errors"
    },
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/discount-overview"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Applied per promotion (rate)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (promotion_id) (rate(discount_applied_total{deployment_environment=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{promotion_id}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Discount granted per promotion (rate, minor units)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (promotion_id) (rate(discount_applied_amount_total{deployment_environment=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{promotion_id}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Applications and discount by promotion (last $__range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (promotion_id) (increase(discount_applied_total{deployment_environment=~\"$env\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (promotion_id) (increase(discount_applied_amount_total{deployment_environment=~\"$env\"}[$__range]))",
          "legendFormat": "",
          "refId": "B",
          "range": false,
          "format": "table",
          "instant": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (promotion_id) (increase(discount_skipped_total{deployment_environment=~\"$env\"}[$__range]))",
          "legendFormat": "",
          "refId": "C",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "promotion_id",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true
            },
            "renameByName": {
              "Value #A": "applied",
              "Value #B": "discount (minor units)",
              "Value #C": "skipped"
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Skipped by reason (last $__range)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (promotion_id, reason) (increase(discount_skipped_total{deployment_environment=~\"$env\"}[$__range]))",
          "legendFormat": "{{promotion_id}} {{reason}}",
          "refId": "A",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "normal",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "xField": "promotion_id"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Clamp reasons (share of applications)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (clamped_by) (increase(discount_applied_total{deployment_environment=~\"$env\"}[$__range]))",
          "legendFormat": "{{clamped_by}}",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Clamped applications over time",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (clamped_by) (rate(discount_applied_total{deployment_environment=~\"$env\"}[$__rate_interval]))",
          "legendFormat": "{{clamped_by}}",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    }
  ]
}