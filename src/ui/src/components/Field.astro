---
// One labelled input bound to a flat form field (model/fields.ts): value from `state.fields`,
// error from `state.errors`. Identifiers, codes, numbers, timestamps and JSON are monospace;
// free text (titles, descriptions, attribute values) is not. `help` adds a tooltip to the
// label; `optionHelp` explains the chosen option of a select under it.
import type { FormState } from "../actions/run";
import Help from "./Help.astro";
interface Props {
  state: FormState; name: string; label: string;
  type?: "text" | "number" | "datetime-local"; placeholder?: string; hint?: string; help?: string;
  readonly?: boolean; required?: boolean; options?: readonly string[]; empty?: string; optionHelp?: Record<string, string>;
  textarea?: boolean; checkbox?: boolean; variantSelect?: boolean; mono?: boolean; rows?: number; utc?: boolean; hintHtml?: boolean;
}
const { state, name, label, type = "text", placeholder, hint, help, readonly = false, required = false, options, empty, optionHelp, textarea = false, checkbox = false, variantSelect = false, rows = 4, utc = false, hintHtml = false } = Astro.props;
const mono = Astro.props.mono ?? (type !== "text" || /(_id$|^id$|^code$|currency$|^from$|^to$|^prefix$|labels$|tags$|coupon_codes$|allowlisted$|customer_ids$|^json$|^source$|\.key$)/.test(name));
const value = state.fields[name] ?? "";
const error = state.errors.find((e) => e.field === name)?.message;
const cls = mono ? "input mono" : "input";
---
<label class="block">
  {checkbox ? (
    <span class="check"><input type="checkbox" name={name} checked={value === "on" || value === "true" || value === "1"} /><span>{label}</span>{help && <Help text={help} />}</span>
  ) : (
    <>
      <span class="label">{label}{required && <span style="color: var(--color-danger)"> *</span>}{help && <Help text={help} />}</span>
      {options ? (
        <select name={name} class="input" data-variant-select={variantSelect ? "" : undefined} data-has-help={optionHelp ? "" : undefined}>
          {empty !== undefined && <option value="" selected={value === ""}>{empty}</option>}
          {options.map((o) => <option value={o} selected={o === value}>{o}</option>)}
        </select>
      ) : textarea ? (
        <textarea name={name} rows={rows} class={cls} placeholder={placeholder}>{value}</textarea>
      ) : (
        <input type={type} name={name} value={value} class={cls} placeholder={placeholder} readonly={readonly} inputmode={type === "number" ? "numeric" : undefined} data-utc={utc ? "" : undefined} />
      )}
    </>
  )}
  {optionHelp && (
    <span class="hint" data-option-help>
      {Object.entries(optionHelp).map(([k, text]) => <span data-for={k} hidden={k !== value}>{text}</span>)}
    </span>
  )}
  {hint && (hintHtml ? <span class="hint" set:html={hint} /> : <span class="hint">{hint}</span>)}
  {error && <span class="field-error">{error}</span>}
</label>
