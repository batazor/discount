---
import { actions } from "astro:actions";
import type { Campaign } from "../../model/campaign";
import Field from "../Field.astro";
import TimestampField from "../TimestampField.astro";
import FormStatus from "../FormStatus.astro";
import DeleteButton from "../DeleteButton.astro";
import GeneratedCodes from "../GeneratedCodes.astro";
import When from "../When.astro";
import Help from "../Help.astro";
import { formState } from "../../actions/run";
import { CONSEQUENCE, TERM } from "../../model/glossary";
interface Props { campaign: Campaign; fresh: string[] }
const { campaign: c, fresh } = Astro.props;
const id = c.promotion.promotion_id;
const generated = Astro.getActionResult(actions.generateCoupons);
const deleted = Astro.getActionResult(actions.deleteCoupon);
const genState = formState(generated?.data, { promotion_id: id, count: "10", prefix: "", max_uses: "1" });
genState.fields.promotion_id = id;
const codes = generated?.data?.kind === "ok" ? generated.data.data.codes : fresh;
const needsCode = c.promotion.rules.some((r) => r.type === "RequiresCoupon");
const act = (a: string) => `?tab=codes&${a.slice(1)}`;
const rowText = (x: Campaign["codes"][number]) => [x.code, x.customer_id ?? "public"].join(" ").toLowerCase();
---
<div class="space-y-5">
  {!needsCode && <p class="alert alert-warn">This campaign has no "Needs a code" rule, so codes do nothing for it. Add the rule under Rules &amp; action.</p>}
  <GeneratedCodes codes={codes} />
  <FormStatus state={formState(deleted?.data, {})} okText="Deleted." />
  <form method="post" action={act(String(actions.generateCoupons))} class="card grid grid-cols-2 gap-3 md:grid-cols-4">
    <input type="hidden" name="promotion_id" value={id} />
    <Field state={genState} name="count" label="How many" type="number" required hint="1–10000" />
    <Field state={genState} name="prefix" label="Prefix" placeholder="SUM-" hint="followed by 8 random characters" />
    <Field state={genState} name="max_uses" label="Uses per code" type="number" help={TERM.couponMaxUses} hint="empty = unlimited" />
    <Field state={genState} name="customer_id" label="Bound to customer" help={TERM.couponBound} hint="empty = public" />
    <TimestampField state={genState} name="starts_at" label="Valid from" />
    <TimestampField state={genState} name="ends_at" label="Valid until" />
    <div class="col-span-2 self-end"><button type="submit" class="btn btn-primary">Generate codes</button></div>
    <div class="col-span-full"><FormStatus state={genState} okText="" /></div>
  </form>
  <div data-filter-root>
    <div class="toolbar">
      <div data-filter-ui hidden><label class="block"><span class="label">Filter</span><input type="search" data-filter placeholder="code or customer" class="input w-56" /></label></div>
      <span class="badge badge-muted"><span data-filter-count>{c.codes.length}</span> codes</span>
    </div>
    <div class="table-card">
      <table class="table">
        <thead><tr><th>Code</th><th>Customer <Help text={TERM.couponBound} /></th><th>Valid from</th><th>Valid until</th><th class="num">Uses <Help text={TERM.couponMaxUses} /></th><th></th></tr></thead>
        <tbody>
          {c.codes.map((x) => (
            <tr data-row-text={rowText(x)}>
              <td><a href={`/coupons/${encodeURIComponent(x.code)}`} class="link mono">{x.code}</a></td>
              <td>{x.customer_id ? <span class="mono">{x.customer_id}</span> : <span class="badge badge-muted">public</span>}</td>
              <td class="text-[12px]"><When ts={x.starts_at} /></td>
              <td class="text-[12px]"><When ts={x.ends_at} /></td>
              <td class="num mono">{x.uses} / {x.max_uses ?? "∞"}</td>
              <td class="actions"><DeleteButton action={act(String(actions.deleteCoupon))} id={x.code} size="xs" consequence={CONSEQUENCE.deleteCoupon} /></td>
            </tr>
          ))}
          {c.codes.length === 0 && <tr><td colspan="6" class="empty">No codes yet.</td></tr>}
          <tr data-filter-empty hidden><td colspan="6" class="empty">Nothing matches the filter.</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
