---
// A form posting the id to a delete-like action. With scripts, client/confirm.ts opens the
// page's dialog with `consequence`; without, the browser's confirm() asks.
interface Props { action: string; id: string; label?: string; extra?: Record<string, string>; size?: "xs" | "md"; consequence?: string; title?: string }
const { action, id, label = "Delete", extra = {}, size = "md", consequence, title } = Astro.props;
const safeId = id.replace(/'/g, "");
---
<form method="post" action={action} class="inline" onsubmit={`return confirm('${label} ${safeId}?')`}
      data-confirm={consequence ?? `${label} ${id}.`} data-confirm-title={title ?? `${label} ${id}?`} data-confirm-label={label}>
  <input type="hidden" name="id" value={id} />
  {Object.entries(extra).map(([k, v]) => <input type="hidden" name={k} value={v} />)}
  <button type="submit" class={size === "xs" ? "btn-xs danger" : "btn btn-secondary"} style={size === "md" ? "color: var(--color-danger)" : undefined}>{label}</button>
</form>
