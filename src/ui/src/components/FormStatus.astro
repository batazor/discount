---
import type { FormState } from "../actions/run";
import ApiError from "./ApiError.astro";
import Unreachable from "./Unreachable.astro";
interface Props { state: FormState; okText?: string }
const { state, okText = "Saved." } = Astro.props;
---
{state.step && (
  <p role="alert" class="alert alert-warn"><span class="alert-title">Step "{state.step}" failed.</span> {state.saved.length ? `Saved before it: ${state.saved.join(", ")}.` : "Nothing was saved."} {state.saved.length > 0 && "Open the campaign to finish by hand, or fix the field and submit again; saved steps are repeated harmlessly."}</p>
)}
{state.api && <ApiError status={state.api.status} body={state.api.body} traceId={state.traceId} />}
{state.unreachable && <Unreachable url={state.unreachable} traceId={state.traceId} />}
{state.ok && <p role="status" class="alert alert-success">{okText}</p>}
{state.errors.length > 0 && (
  <p role="alert" class="field-error">Fix the {state.errors.length} highlighted field{state.errors.length > 1 && "s"}; nothing was sent.</p>
)}
