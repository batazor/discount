---
// Unix seconds in the contract; entered as a datetime in the viewer's zone (UTC without
// scripts) or the raw integer. The integer that will be sent is shown alongside.
import type { FormState } from "../actions/run";
import { parseTimestamp } from "../model/time";
import Field from "./Field.astro";
interface Props { state: FormState; name: string; label: string }
const { state, name, label } = Astro.props;
const ts = parseTimestamp(state.fields[name] ?? "");
// A value the server rendered from the API is UTC and gets shifted by the script; a value
// posted back by the viewer (the form carried tz_offset_minutes) is already local.
const posted = "tz_offset_minutes" in state.fields;
const hint = ts === null ? "empty = none" : ts === undefined ? "" : posted ? "" : `sends ${ts}`;
---
<Field state={state} name={name} label={label} type="datetime-local" utc={!posted} hintHtml hint={`in <span data-zone>UTC</span>; ${hint}`.replace(/; $/, "")} />
