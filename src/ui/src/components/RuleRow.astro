---
// One rule of a promotion: a variant picker and the fields of every variant (only the
// chosen one is shown once scripts run; without scripts all are visible and only the
// chosen variant's fields are read, see model/promotion.ts).
import type { FormState } from "../actions/run";
import Field from "./Field.astro";
import MoneyField from "./MoneyField.astro";
import TimestampField from "./TimestampField.astro";
import { RULE_TYPES } from "../model/promotion";
interface Props { state: FormState; index: string }
const { state, index } = Astro.props;
const p = `rules.${index}`;
---
<div data-row={index} class="card space-y-3">
  <div class="flex items-end gap-2">
    <div class="flex-1"><Field state={state} name={`${p}.type`} label={`Rule #${index}`} options={RULE_TYPES} empty="— none —" variantSelect /></div>
    <button type="button" data-remove-row hidden class="row-remove">Remove</button>
  </div>
  <div data-variant="DateWindow" class="grid grid-cols-2 gap-2">
    <TimestampField state={state} name={`${p}.starts_at`} label="starts_at" />
    <TimestampField state={state} name={`${p}.ends_at`} label="ends_at" />
  </div>
  <div data-variant="OrderTotalRange" class="grid grid-cols-2 gap-2">
    <MoneyField state={state} name={`${p}.min`} label="min" />
    <MoneyField state={state} name={`${p}.max`} label="max" />
  </div>
  <div data-variant="TagsMatch" class="grid grid-cols-3 gap-2">
    <Field state={state} name={`${p}.all`} label="all (comma-separated)" />
    <Field state={state} name={`${p}.any`} label="any" />
    <Field state={state} name={`${p}.none`} label="none" />
  </div>
  <div data-variant="AttributeIn" class="grid grid-cols-2 gap-2">
    <Field state={state} name={`${p}.key`} label="key" />
    <Field state={state} name={`${p}.values`} label="values (comma-separated)" />
  </div>
  <div data-variant="AttributeDateWindow" class="grid grid-cols-3 gap-2">
    <Field state={state} name={`${p}.key`} label="key" />
    <TimestampField state={state} name={`${p}.starts_at`} label="starts_at" />
    <TimestampField state={state} name={`${p}.ends_at`} label="ends_at" />
  </div>
  {(["MaxCompletedOrders", "MaxUsesPerCustomer", "MaxUsesTotal"] as const).map((t) => (
    <div data-variant={t}><Field state={state} name={`${p}.max`} label="max" type="number" /></div>
  ))}
  <div data-variant="RequiresCoupon" class="hint">Applies only when a stored coupon for this promotion is presented.</div>
</div>
