---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Unreachable from "../components/Unreachable.astro";
import ConfirmDialog from "../components/ConfirmDialog.astro";
import { API_URL } from "../api/client";
import { navigation, roleFrom, ROLE_HELP, ROLES } from "../model/role";

type Crumb = [label: string, href?: string];
interface Props { title: string; unreachable?: string | null; description?: string; crumbs?: Crumb[] }
const { title, unreachable = null, description, crumbs = [] } = Astro.props;

const role = roleFrom(Astro.cookies.get("discount_role")?.value);
const groups = navigation(role);
const path = Astro.url.pathname;
const active = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`));
const flat: [string, string][] = [["/", "Overview"], ...groups.flatMap(([, l]) => l)];
const back = encodeURIComponent(path + Astro.url.search);
---
<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · discount</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%234f46e5'/%3E%3Ctext x='16' y='22' font-size='18' font-weight='700' font-family='system-ui' fill='white' text-anchor='middle'%3E%25%3C/text%3E%3C/svg%3E" />
    <ClientRouter />
    <script>
      import "../client/help";
      import "../client/confirm";
      import "../client/filter";
      import "../client/localtime";
    </script>
  </head>
  <body class="min-h-full">
    <nav class="topbar">
      <a href="/" class="mr-2 flex size-7 shrink-0 items-center justify-center rounded-md text-[13px] font-bold text-white" style="background: var(--color-accent)">%</a>
      {flat.map(([href, label]) => <a href={href} class="nav-link" aria-current={active(href) ? "page" : undefined}>{label}</a>)}
    </nav>
    <div class="flex min-h-screen">
      <nav class="sidebar">
        <a href="/" class="mb-3 flex items-center gap-2 px-2.5 py-1 no-underline">
          <span class="flex size-7 items-center justify-center rounded-md text-[13px] font-bold text-white" style="background: var(--color-accent)">%</span>
          <span class="text-[15px] font-semibold tracking-tight">discount</span>
        </a>
        <div class="role-switch" role="group" aria-label="Role">
          {ROLES.map((r) => <a href={`/role?set=${r}&back=${back}`} class="role-option" aria-current={r === role ? "true" : undefined} data-tip={ROLE_HELP[r]}>{r}</a>)}
        </div>
        <a href="/" class="nav-link mt-3" aria-current={active("/") ? "page" : undefined}>Overview</a>
        {groups.map(([group, links]) => (
          <>
            <div class="nav-group">{group}</div>
            {links.map(([href, label]) => <a href={href} class="nav-link" aria-current={active(href) ? "page" : undefined}>{label}</a>)}
          </>
        ))}
        <div class="mt-auto px-2.5 pt-4 text-[11px] leading-4" style="color: var(--color-ink-3)">
          <div class="font-semibold uppercase tracking-[0.08em]">Service</div>
          <code class="block truncate" title={API_URL}>{API_URL}</code>
          <a href={`${API_URL}/docs`} class="link mt-1 inline-block" target="_blank" rel="noreferrer">OpenAPI docs ↗</a>
        </div>
      </nav>
      <main class="min-w-0 flex-1 px-5 py-6 md:px-10 md:py-8">
        <div class="mx-auto max-w-6xl">
          <header class="mb-6">
            {crumbs.length > 0 && (
              <nav class="crumbs" aria-label="Breadcrumb">
                {crumbs.map(([label, href], i) => <>{i > 0 && <span>/</span>}{href ? <a href={href}>{label}</a> : <span>{label}</span>}</>)}
              </nav>
            )}
            <div class="page-head">
              <div class="min-w-0">
                <h1 class="page-title flex flex-wrap items-center gap-2.5">{title}<slot name="badge" /></h1>
                {description && <p class="lede mt-1" set:html={description} />}
              </div>
              <div class="flex shrink-0 items-center gap-2"><slot name="actions" /></div>
            </div>
          </header>
          {unreachable && <div class="mb-5"><Unreachable url={unreachable} /></div>}
          <slot />
        </div>
      </main>
      <ConfirmDialog />
    </div>
  </body>
</html>
