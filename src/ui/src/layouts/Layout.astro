---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Unreachable from "../components/Unreachable.astro";
import { API_URL } from "../api/client";

interface Props { title: string; unreachable?: string | null; description?: string }
const { title, unreachable = null, description } = Astro.props;

const groups: [string, [string, string][]][] = [
  ["Catalogue", [["/policy", "Policy"], ["/groups", "Groups"], ["/promotions", "Promotions"], ["/coupons", "Coupons"], ["/grant-rules", "Grant rules"], ["/exchange-rates", "Exchange rates"]]],
  ["Operations", [["/redemptions", "Redemptions"], ["/customers", "Customers"]]],
  ["Tools", [["/evaluate", "Evaluate playground"]]],
];
const path = Astro.url.pathname;
const active = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`));
---
<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · discount</title>
    <ClientRouter />
  </head>
  <body class="min-h-full">
    <div class="flex min-h-screen">
      <nav class="sticky top-0 flex h-screen w-56 shrink-0 flex-col border-r px-3 py-4" style="border-color: var(--color-line); background: var(--color-surface)">
        <a href="/" class="mb-2 flex items-center gap-2 px-2.5 py-1 no-underline">
          <span class="flex size-7 items-center justify-center rounded-md text-[13px] font-bold text-white" style="background: var(--color-accent)">%</span>
          <span class="text-[15px] font-semibold tracking-tight">discount</span>
        </a>
        <a href="/" class="nav-link" aria-current={active("/") ? "page" : undefined}>Overview</a>
        {groups.map(([group, links]) => (
          <>
            <div class="nav-group">{group}</div>
            {links.map(([href, label]) => <a href={href} class="nav-link" aria-current={active(href) ? "page" : undefined}>{label}</a>)}
          </>
        ))}
        <div class="mt-auto px-2.5 pt-4 text-[11px] leading-4" style="color: var(--color-ink-3)">
          <div class="font-semibold uppercase tracking-[0.08em]">Service</div>
          <code class="block truncate" title={API_URL}>{API_URL}</code>
          <a href={`${API_URL}/docs`} class="link mt-1 inline-block" target="_blank" rel="noreferrer">OpenAPI docs ↗</a>
        </div>
      </nav>
      <main class="min-w-0 flex-1 px-10 py-8">
        <div class="mx-auto max-w-6xl">
          <header class="mb-6">
            <h1 class="page-title">{title}</h1>
            {description && <p class="lede mt-1" set:html={description} />}
          </header>
          {unreachable && <div class="mb-5"><Unreachable url={unreachable} /></div>}
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
