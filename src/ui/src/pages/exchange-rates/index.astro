---
import { actions } from "astro:actions";
import Layout from "../../layouts/Layout.astro";
import FormStatus from "../../components/FormStatus.astro";
import Field from "../../components/Field.astro";
import { api, call, unreachableUrl, dataOr } from "../../api/client";
import { formState } from "../../actions/run";

const put = Astro.getActionResult(actions.putExchangeRate);
const deleted = Astro.getActionResult(actions.deleteExchangeRate);
const rates = await call(() => api.GET("/v1/exchange-rates"));
const putState = formState(put?.data, { denominator: "100" });
const delState = formState(deleted?.data, {});
---
<Layout title="Exchange rates" unreachable={unreachableUrl(rates)}>
  <p class="lede mb-5">
    A rate converts <code class="mono">from</code> into <code class="mono">to</code> as <code class="mono">amount × numerator / denominator</code>, rounded by the policy. Integers only.
  </p>
  <form method="post" action={actions.putExchangeRate} class="card mb-6 grid max-w-3xl grid-cols-2 gap-3 md:grid-cols-5">
    <Field state={putState} name="from" label="from" placeholder="USD" required />
    <Field state={putState} name="to" label="to" placeholder="EUR" required />
    <Field state={putState} name="numerator" label="numerator" type="number" required />
    <Field state={putState} name="denominator" label="denominator" type="number" required />
    <div class="self-end"><button type="submit" class="btn btn-primary">Set rate</button></div>
    <div class="col-span-full"><FormStatus state={putState} okText="Rate stored." /></div>
  </form>
  <FormStatus state={delState} okText="Deleted." />
  <div class="table-card"><table class="table">
    <thead><tr><th>from</th><th>to</th><th>numerator</th><th>denominator</th><th></th></tr></thead>
    <tbody>
      {dataOr(rates, []).map((r) => (
        <tr>
          <td class="mono">{r.from}</td>
          <td class="mono">{r.to}</td>
          <td class="mono">{r.numerator}</td>
          <td class="mono">{r.denominator}</td>
          <td class="text-right">
            <form method="post" action={actions.deleteExchangeRate} class="inline" onsubmit={`return confirm('Delete ${r.from}→${r.to}?')`}>
              <input type="hidden" name="from" value={r.from} /><input type="hidden" name="to" value={r.to} />
              <button type="submit" class="link-danger">Delete</button>
            </form>
          </td>
        </tr>
      ))}
      {rates.ok && rates.data.length === 0 && <tr><td colspan="5" class="empty">No rates.</td></tr>}
    </tbody>
  </table></div>
</Layout>
