---
import { actions } from "astro:actions";
import { tenantLabel } from "../../model/tenant";
import { authEnabled } from "../../auth/config";
import Layout from "../../layouts/Layout.astro";
import DeleteButton from "../../components/DeleteButton.astro";
import FormStatus from "../../components/FormStatus.astro";
import Field from "../../components/Field.astro";
import TimestampField from "../../components/TimestampField.astro";
import { api, call, unreachableUrl, dataOr } from "../../api/client";
import { CONSEQUENCE } from "../../model/glossary";
import { formState } from "../../actions/run";
import When from "../../components/When.astro";
import { TERM } from "../../model/glossary";
import Help from "../../components/Help.astro";

const deleted = Astro.getActionResult(actions.deleteCoupon);
const generated = Astro.getActionResult(actions.generateCoupons);
const [coupons, promotions] = await Promise.all([call(() => api.GET("/v1/coupons")), call(() => api.GET("/v1/promotions"))]);
const delState = formState(deleted?.data, {});
const genState = formState(generated?.data, { count: "10", prefix: "", max_uses: "1" });
const codes = generated?.data?.kind === "ok" ? generated.data.data.codes : [];
const promotionIds = dataOr(promotions, []).map((p) => p.promotion_id);
const rows = dataOr(coupons, []);
const tenant = tenantLabel(Astro.locals.user ?? null, authEnabled);
---
<Layout title="Coupons" description={`Stored codes of <b>${tenant.name}</b>. A code turns on a campaign that requires one.`} unreachable={unreachableUrl(coupons, promotions)}>
  <Fragment slot="badge">{coupons.ok && <span class="badge badge-muted">{rows.length}</span>}</Fragment>
  <a slot="actions" href="/coupons/new" class="btn btn-primary">New coupon</a>
  <FormStatus state={delState} okText="Deleted." />

  <details class="card mb-5" open={!!generated}>
    <summary>Generate a batch of codes</summary>
    <form method="post" action={actions.generateCoupons} class="mt-4 grid grid-cols-2 gap-3 md:grid-cols-4">
      <Field state={genState} name="promotion_id" label="Promotion" options={promotionIds} empty="— choose —" required />
      <Field state={genState} name="count" label="How many" type="number" required hint="1–10000" />
      <Field state={genState} name="prefix" label="Prefix" placeholder="SPRING-" hint="followed by 8 random characters" />
      <Field state={genState} name="max_uses" label="Uses per code" type="number" help={TERM.couponMaxUses} hint="empty = unlimited" />
      <TimestampField state={genState} name="starts_at" label="Valid from" />
      <TimestampField state={genState} name="ends_at" label="Valid until" />
      <Field state={genState} name="customer_id" label="Bound to customer" help={TERM.couponBound} hint="empty = public" />
      <div class="self-end"><button type="submit" class="btn btn-primary">Generate</button></div>
      <div class="col-span-full"><FormStatus state={genState} okText={`Generated ${codes.length} code${codes.length === 1 ? "" : "s"}. They are listed once here; copy them now.`} /></div>
    </form>
    {codes.length > 0 && (
      <ul id="generated-codes" class="mt-3 grid grid-cols-2 gap-1.5 md:grid-cols-4">
        {codes.map((c) => <li data-code class="mono rounded-md px-2.5 py-1.5 select-all" style="background: var(--color-surface-2)">{c}</li>)}
      </ul>
    )}
  </details>

  <div class="table-card">
    <table class="table">
      <thead>
        <tr><th>Code</th><th>Promotion</th><th>Customer <Help text={TERM.couponBound} /></th><th>Valid from</th><th>Valid until <Help text={TERM.couponWindow} /></th><th class="num">Uses <Help text={TERM.couponMaxUses} /></th><th></th></tr>
      </thead>
      <tbody>
        {rows.map((c) => (
          <tr>
            <td><a href={`/coupons/${encodeURIComponent(c.code)}`} class="link mono">{c.code}</a></td>
            <td><a href={`/campaigns/${encodeURIComponent(c.promotion_id)}`} class="link mono">{c.promotion_id}</a></td>
            <td>{c.customer_id ? <span class="mono">{c.customer_id}</span> : <span class="badge badge-muted">public</span>}</td>
            <td class="text-[12px]"><When ts={c.starts_at} /></td>
            <td class="text-[12px]"><When ts={c.ends_at} /></td>
            <td class="num mono">{c.uses} / {c.max_uses ?? "∞"}</td>
            <td class="actions"><DeleteButton action={actions.deleteCoupon} id={c.code} consequence={CONSEQUENCE.deleteCoupon} size="xs" /></td>
          </tr>
        ))}
        {coupons.ok && rows.length === 0 && <tr><td colspan="7" class="empty">No coupons yet.</td></tr>}
      </tbody>
    </table>
  </div>
  <script>
    // The generated codes are in the DOM before this runs; the stagger only reveals them.
    import { animate, stagger } from "motion";
    const reveal = () => {
      const items = document.querySelectorAll("#generated-codes [data-code]");
      if (!items.length || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      animate(items, { opacity: [0, 1], y: [4, 0] }, { delay: stagger(0.03), duration: 0.2 });
    };
    reveal();
    document.addEventListener("astro:page-load", reveal);
  </script>
</Layout>
