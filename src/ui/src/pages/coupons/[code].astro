---
import { actions } from "astro:actions";
import Layout from "../../layouts/Layout.astro";
import Field from "../../components/Field.astro";
import TimestampField from "../../components/TimestampField.astro";
import FormStatus from "../../components/FormStatus.astro";
import ApiError from "../../components/ApiError.astro";
import DeleteButton from "../../components/DeleteButton.astro";
import { api, call, unreachableUrl, dataOr } from "../../api/client";
import { CONSEQUENCE } from "../../model/glossary";
import { formState } from "../../actions/run";
import { couponToFields } from "../../model/catalogue";
import { TERM } from "../../model/glossary";

const code = Astro.params.code!;
const isNew = code === "new";
const result = Astro.getActionResult(actions.putCoupon);
if (isNew && result?.data?.kind === "ok") return Astro.redirect(`/coupons/${encodeURIComponent(result.data.data.code)}`);

const [current, promotions] = await Promise.all([
  isNew ? Promise.resolve(null) : call(() => api.GET("/v1/coupons/{code}", { params: { path: { code } } })),
  call(() => api.GET("/v1/promotions")),
]);
const state = formState(result?.data, current?.ok ? couponToFields(current.data) : {});
const promotionIds = dataOr(promotions, []).map((p) => p.promotion_id);
---
<Layout title={isNew ? "New coupon" : code} crumbs={[["Coupons", "/coupons"], [isNew ? "New" : code]]} unreachable={unreachableUrl(current ?? promotions, promotions)}>
  <Fragment slot="badge">{current?.ok && (current.data.customer_id ? <span class="badge badge-info">bound to {current.data.customer_id}</span> : <span class="badge badge-muted">public</span>)}</Fragment>
  <Fragment slot="actions">{!isNew && current?.ok && <DeleteButton action={actions.deleteCoupon} id={code} consequence={CONSEQUENCE.deleteCoupon} />}</Fragment>
  {current && !current.ok && !current.unreachable && <ApiError status={current.status} body={current.body} traceId={current.traceId} />}
  <form method="post" action={actions.putCoupon} class="max-w-3xl space-y-5">
    <section class="card grid grid-cols-2 gap-4">
      <Field state={state} name="code" label="Code" required readonly={!isNew} />
      <Field state={state} name="promotion_id" label="Promotion" options={promotionIds} empty="— choose —" required />
      <TimestampField state={state} name="starts_at" label="Valid from" />
      <TimestampField state={state} name="ends_at" label="Valid until" />
      <Field state={state} name="customer_id" label="Bound to customer" help={TERM.couponBound} hint="empty = public" />
      <Field state={state} name="max_uses" label="Maximum uses" type="number" help={TERM.couponMaxUses} hint="empty = unlimited, 1 = single use" />
      {!isNew && (
        <label class="block">
          <span class="label">Uses so far</span>
          <input type="text" name="uses" value={current?.ok ? String(current.data.uses) : ""} readonly class="input mono" />
          <span class="hint">{TERM.couponUses} Not editable.</span>
        </label>
      )}
    </section>
    <FormStatus state={state} />
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">{isNew ? "Create coupon" : "Save coupon"}</button>
      <a href="/coupons" class="btn btn-ghost">Back to coupons</a>
    </div>
  </form>
</Layout>
