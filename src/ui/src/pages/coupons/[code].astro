---
import { actions } from "astro:actions";
import Layout from "../../layouts/Layout.astro";
import Field from "../../components/Field.astro";
import TimestampField from "../../components/TimestampField.astro";
import FormStatus from "../../components/FormStatus.astro";
import ApiError from "../../components/ApiError.astro";
import { api, call, unreachableUrl, dataOr } from "../../api/client";
import { formState } from "../../actions/run";
import { couponToFields } from "../../model/catalogue";

const code = Astro.params.code!;
const isNew = code === "new";
const result = Astro.getActionResult(actions.putCoupon);
if (isNew && result?.data?.kind === "ok") return Astro.redirect(`/coupons/${encodeURIComponent(result.data.data.code)}`);

const [current, promotions] = await Promise.all([
  isNew ? Promise.resolve(null) : call(() => api.GET("/v1/coupons/{code}", { params: { path: { code } } })),
  call(() => api.GET("/v1/promotions")),
]);
const state = formState(result?.data, current?.ok ? couponToFields(current.data) : {});
const promotionIds = dataOr(promotions, []).map((p) => p.promotion_id);
---
<Layout title={isNew ? "New coupon" : `Coupon ${code}`} unreachable={unreachableUrl(current ?? promotions, promotions)}>
  {current && !current.ok && !current.unreachable && <ApiError status={current.status} body={current.body} />}
  <form method="post" action={actions.putCoupon} class="mt-4 grid max-w-2xl grid-cols-2 gap-3">
    <Field state={state} name="code" label="code" required readonly={!isNew} />
    <Field state={state} name="promotion_id" label="promotion_id" options={promotionIds} empty="— choose —" required />
    <TimestampField state={state} name="starts_at" label="starts_at" />
    <TimestampField state={state} name="ends_at" label="ends_at" />
    <Field state={state} name="customer_id" label="customer_id (empty = public)" />
    <Field state={state} name="max_uses" label="max_uses (empty = unlimited, 1 = single use)" type="number" />
    {!isNew && (
      <label class="block">
        <span class="label">uses (derived by the service)</span>
        <input type="text" name="uses" value={current?.ok ? String(current.data.uses) : ""} readonly class="input" />
        <span class="hint">Counted from redemptions; ignored on save.</span>
      </label>
    )}
    <div class="col-span-full"><FormStatus state={state} /></div>
    <div class="col-span-full flex gap-3">
      <button type="submit" class="btn btn-primary">{isNew ? "Create" : "Save"}</button>
      <a href="/coupons" class="btn btn-ghost">Back to coupons</a>
    </div>
  </form>
</Layout>
