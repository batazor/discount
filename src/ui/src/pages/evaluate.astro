---
import { actions } from "astro:actions";
import Layout from "../layouts/Layout.astro";
import Field from "../components/Field.astro";
import MoneyField from "../components/MoneyField.astro";
import FormStatus from "../components/FormStatus.astro";
import ResultPanel from "../components/ResultPanel.astro";
import { formState } from "../actions/run";
import { evaluateRequestToFields, SAMPLE_REQUEST } from "../model/evaluate";
import { Form } from "../model/fields";

const result = Astro.getActionResult(actions.evaluate);
// The playground keeps what was posted even after a success, to tweak and re-run.
const state = formState(result?.data, evaluateRequestToFields(SAMPLE_REQUEST));
if (result?.data?.kind === "ok") state.fields = result.data.fields;
const priced = result?.data?.kind === "ok" ? result.data.data : null;
const f = new Form(state.fields);
const empty = formState(undefined, {});
const lines = f.rows("lines").map(String);
const attrs = f.rows("attributes").map(String);
const uses = f.rows("uses").map(String);
const box = "card space-y-3";
---
<Layout title="Evaluate" unreachable={result?.data?.kind === "unreachable" ? result.data.url : null}>
  <p class="lede mb-5">
    Price a cart and see why each promotion applied or did not. Nothing is stored.
  </p>
  <div class="grid gap-6 xl:grid-cols-2">
    <form method="post" action={actions.evaluate} class="space-y-4">
      <fieldset class={box}>
        <legend class="card-legend">Cart</legend>
        <div class="grid grid-cols-3 gap-2">
          <Field state={state} name="cart.currency" label="currency" required />
          <Field state={state} name="cart.tags" label="tags (comma-separated)" />
          <Field state={state} name="cart.coupon_codes" label="coupon_codes (comma-separated)" />
        </div>
        <div data-row-list>
          <p class="hint">Lines</p>
          <div data-rows class="space-y-1">
            {lines.map((i) => (
              <div data-row={i} class="grid grid-cols-[1fr_1fr_6rem_5rem_auto] items-end gap-2">
                <Field state={state} name={`lines.${i}.line_id`} label="line_id" />
                <Field state={state} name={`lines.${i}.unit_price.amount`} label="unit_price (minor units)" type="number" />
                <Field state={state} name={`lines.${i}.unit_price.currency`} label="currency" />
                <Field state={state} name={`lines.${i}.quantity`} label="qty" type="number" />
                <button type="button" data-remove-row hidden class="row-remove">×</button>
              </div>
            ))}
          </div>
          <template data-row-template>
            <div data-row="__i__" class="grid grid-cols-[1fr_1fr_6rem_5rem_auto] items-end gap-2">
              <Field state={empty} name="lines.__i__.line_id" label="line_id" />
              <Field state={empty} name="lines.__i__.unit_price.amount" label="unit_price (minor units)" type="number" />
              <Field state={empty} name="lines.__i__.unit_price.currency" label="currency" />
              <Field state={empty} name="lines.__i__.quantity" label="qty" type="number" />
              <button type="button" data-remove-row hidden class="row-remove">×</button>
            </div>
          </template>
          <button type="button" data-add-row hidden class="row-add">Add line</button>
        </div>
        <div data-row-list>
          <p class="hint">Attributes</p>
          <div data-rows class="space-y-1">
            {attrs.map((i) => (
              <div data-row={i} class="grid grid-cols-[1fr_1fr_auto] items-end gap-2">
                <Field state={state} name={`attributes.${i}.key`} label="key" />
                <Field state={state} name={`attributes.${i}.value`} label="value" />
                <button type="button" data-remove-row hidden class="row-remove">×</button>
              </div>
            ))}
          </div>
          <template data-row-template>
            <div data-row="__i__" class="grid grid-cols-[1fr_1fr_auto] items-end gap-2">
              <Field state={empty} name="attributes.__i__.key" label="key" />
              <Field state={empty} name="attributes.__i__.value" label="value" />
              <button type="button" data-remove-row hidden class="row-remove">×</button>
            </div>
          </template>
          <button type="button" data-add-row hidden class="row-add">Add attribute</button>
        </div>
      </fieldset>

      <fieldset class={box}>
        <legend class="card-legend">Customer</legend>
        <div class="grid grid-cols-2 gap-2">
          <Field state={state} name="customer.customer_id" label="customer_id (empty = anonymous)" hint="The service adds this customer's stored uses" />
          <Field state={state} name="customer.completed_orders" label="completed_orders" type="number" required />
        </div>
        <div data-row-list>
          <p class="hint">Extra uses supplied by the caller</p>
          <div data-rows class="space-y-1">
            {uses.map((i) => (
              <div data-row={i} class="grid grid-cols-[1fr_6rem_auto] items-end gap-2">
                <Field state={state} name={`uses.${i}.promotion_id`} label="promotion_id" />
                <Field state={state} name={`uses.${i}.count`} label="count" type="number" />
                <button type="button" data-remove-row hidden class="row-remove">×</button>
              </div>
            ))}
          </div>
          <template data-row-template>
            <div data-row="__i__" class="grid grid-cols-[1fr_6rem_auto] items-end gap-2">
              <Field state={empty} name="uses.__i__.promotion_id" label="promotion_id" />
              <Field state={empty} name="uses.__i__.count" label="count" type="number" />
              <button type="button" data-remove-row hidden class="row-remove">×</button>
            </div>
          </template>
          <button type="button" data-add-row hidden class="row-add">Add use</button>
        </div>
      </fieldset>

      <details class={box} open={!!state.fields.json}>
        <summary>Paste an EvaluateRequest as JSON instead</summary>
        <Field state={state} name="json" label="EvaluateRequest JSON" textarea placeholder='{"cart": {...}, "customer": {...}}' hint="Sent unchanged; the form above is ignored while this is non-empty." />
      </details>

      <FormStatus state={state} okText="Priced. Nothing was stored." />
      <button type="submit" class="btn btn-primary">Evaluate</button>
    </form>

    <div>
      {priced ? <ResultPanel result={priced} /> : <div class="card flex min-h-40 items-center justify-center" style="color: var(--color-ink-3)">The PricingResult appears here after an evaluation.</div>}
    </div>
  </div>
  <script>
    import { animate } from "motion";
    import { initRows } from "../client/rows";
    initRows();
    // The result is server-rendered and already in the DOM; this only fades it in.
    const reveal = () => {
      const panel = document.getElementById("result");
      if (panel && !window.matchMedia("(prefers-reduced-motion: reduce)").matches)
        animate(panel, { opacity: [0, 1], y: [8, 0] }, { duration: 0.25 });
    };
    reveal();
    document.addEventListener("astro:page-load", reveal);
  </script>
</Layout>
