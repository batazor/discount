---
import Layout from "../../layouts/Layout.astro";
import ApiError from "../../components/ApiError.astro";
import { api, call, unreachableUrl } from "../../api/client";
import When from "../../components/When.astro";
import Money from "../../components/Money.astro";
import Percent from "../../components/Percent.astro";
import { COUPON_STATUS_HELP } from "../../model/glossary";

const customerId = Astro.params.customer_id!;
const source = Astro.url.searchParams.get("source")?.trim() || "";
const list = await call(() =>
  api.GET("/v1/customers/{customer_id}/coupons", { params: { path: { customer_id: customerId }, query: source ? { source } : {} } }),
);
const badge: Record<string, string> = { active: "badge-ok", scheduled: "badge-info", expired: "badge-muted", applied: "badge-warn" };
---
<Layout title={customerId} crumbs={[["Customers", "/customers"], [customerId]]} description="Bound, used and saved coupons with their cart-free status, as the service lists them." unreachable={unreachableUrl(list)}>
  {!list.ok && !list.unreachable && <ApiError status={list.status} body={list.body} traceId={list.traceId} />}
  <form method="get" class="mb-4 flex items-end gap-2">
    <label class="block"><span class="label">Source</span><input type="text" name="source" value={source} placeholder="hotels" class="input mono w-44" /></label>
    <button type="submit" class="btn btn-secondary">Filter</button>
    {source && <a href={`/customers/${encodeURIComponent(customerId)}`} class="btn btn-ghost">Clear</a>}
  </form>
  {list.ok && (
    <div class="table-card">
      <table class="table">
        <thead><tr><th>Code</th><th>Status</th><th>Order</th><th>Promotion</th><th>Valid until</th><th class="num">Uses</th></tr></thead>
        <tbody>
          {list.data.map((c) => (
            <tr>
              <td class="mono"><a href={`/coupons/${encodeURIComponent(c.coupon.code)}`} class="link">{c.coupon.code}</a></td>
              <td><span class={`badge ${badge[c.status]}`} data-tip={COUPON_STATUS_HELP[c.status]}>{c.status}</span></td>
              <td class="mono">{c.order_id ? <a href={`/redemptions/${encodeURIComponent(c.order_id)}`} class="link">{c.order_id}</a> : "—"}</td>
              <td>{c.promotion ? <><a href={`/campaigns/${encodeURIComponent(c.promotion.promotion_id)}`} class="link mono">{c.promotion.promotion_id}</a>{c.promotion.metadata && <span class="ml-1.5" style="color: var(--color-ink-2)">{c.promotion.metadata.title}</span>}<div class="text-[12px]" style="color: var(--color-ink-3)">{c.promotion.action.type === "OrderPercentage" ? <Percent bps={c.promotion.action.bps} /> : <Money m={c.promotion.action.amount} />} off the order</div></> : <span class="badge badge-muted">gone</span>}</td>
              <td class="text-[12px]"><When ts={c.coupon.ends_at} /></td>
              <td class="num mono">{c.coupon.uses} / {c.coupon.max_uses ?? "∞"}</td>
            </tr>
          ))}
          {list.data.length === 0 && <tr><td colspan="6" class="empty">{source ? `No coupons with source "${source}" for this customer.` : "No coupons for this customer."}</td></tr>}
        </tbody>
      </table>
    </div>
  )}
  <p class="mt-6"><a href="/customers" class="btn btn-secondary">Look up another customer</a></p>
</Layout>
