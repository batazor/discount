---
import { actions } from "astro:actions";
import Layout from "../../../layouts/Layout.astro";
import FormStatus from "../../../components/FormStatus.astro";
import Field from "../../../components/Field.astro";
import CurrencySelect from "../../../components/CurrencySelect.astro";
import { api, call, unreachableUrl, dataOr } from "../../../api/client";
import { formState } from "../../../actions/run";
import { CONSEQUENCE, TERM } from "../../../model/glossary";

const put = Astro.getActionResult(actions.putExchangeRate);
const deleted = Astro.getActionResult(actions.deleteExchangeRate);
const rates = await call(() => api.GET("/v1/exchange-rates"));
const putState = formState(put?.data, { denominator: "100" });
const delState = formState(deleted?.data, {});
const rows = dataOr(rates, []);
const access = Astro.locals.access;
---
<Layout title="Exchange rates" description="A rate converts one currency into another as amount × numerator ÷ denominator, rounded by the policy. Integers only." unreachable={unreachableUrl(rates)}>
  <Fragment slot="badge">{rates.ok && <span class="badge badge-muted">{rows.length}</span>}</Fragment>
  {access.write && <form method="post" action={actions.putExchangeRate} class="card mb-5 grid max-w-4xl grid-cols-2 gap-3 md:grid-cols-5">
    <CurrencySelect state={putState} name="from" label="From" required />
    <CurrencySelect state={putState} name="to" label="To" required />
    <Field state={putState} name="numerator" label="Numerator" type="number" required help={TERM.rateFormula} />
    <Field state={putState} name="denominator" label="Denominator" type="number" required />
    <div class="self-end"><button type="submit" class="btn btn-primary">Set rate</button></div>
    <div class="col-span-full"><FormStatus state={putState} okText="Rate stored." /></div>
  </form>}
  <FormStatus state={delState} okText="Deleted." />
  <div class="table-card max-w-3xl">
    <table class="table">
      <thead><tr><th>From</th><th>To</th><th class="num">Rate</th><th></th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="mono">{r.from}</td>
            <td class="mono">{r.to}</td>
            <td class="num mono">{r.numerator} / {r.denominator}</td>
            <td class="actions">
              {access.write && <form method="post" action={actions.deleteExchangeRate} onsubmit={`return confirm('Delete ${r.from}→${r.to}?')`} data-confirm={CONSEQUENCE.deleteRate} data-confirm-title={`Delete the ${r.from} → ${r.to} rate?`} data-confirm-label="Delete">
                <input type="hidden" name="from" value={r.from} /><input type="hidden" name="to" value={r.to} />
                <button type="submit" class="btn-xs danger">Delete</button>
              </form>}
            </td>
          </tr>
        ))}
        {rates.ok && rows.length === 0 && <tr><td colspan="4" class="empty">No rates: carts and promotions must share a currency.</td></tr>}
      </tbody>
    </table>
  </div>
</Layout>
