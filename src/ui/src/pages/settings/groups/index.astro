---
import { actions } from "astro:actions";
import Layout from "../../../layouts/Layout.astro";
import DeleteButton from "../../../components/DeleteButton.astro";
import FormStatus from "../../../components/FormStatus.astro";
import { api, call, unreachableUrl, dataOr } from "../../../api/client";
import { CONSEQUENCE } from "../../../model/glossary";
import { formState } from "../../../actions/run";
import { STACKING_MODE_HELP, TERM } from "../../../model/glossary";
import Help from "../../../components/Help.astro";

const deleted = Astro.getActionResult(actions.deleteGroup);
const groups = await call(() => api.GET("/v1/groups"));
const state = formState(deleted?.data, {});
const rows = dataOr(groups, []);
const access = Astro.locals.access;
---
<Layout title="Stacking groups" description="Groups order promotions and decide whether all of a group apply or only the first match." unreachable={unreachableUrl(groups)}>
  <Fragment slot="badge">{groups.ok && <span class="badge badge-muted">{rows.length}</span>}</Fragment>
  {access.write && <a slot="actions" href="/settings/groups/new" class="btn btn-primary">New group</a>}
  <FormStatus state={state} okText="Deleted." />
  <div class="table-card max-w-3xl">
    <table class="table">
      <thead><tr><th>Group</th><th class="num">Priority <Help text={TERM.groupPriority} /></th><th>Mode</th><th></th></tr></thead>
      <tbody>
        {rows.map((g) => (
          <tr>
            <td><a href={`/settings/groups/${encodeURIComponent(g.group_id)}`} class="link mono">{g.group_id}</a></td>
            <td class="num mono">{g.priority}</td>
            <td><span class={`badge ${g.mode.type === "Stackable" ? "badge-ok" : "badge-info"}`} data-tip={STACKING_MODE_HELP[g.mode.type]}>{g.mode.type}</span></td>
            <td class="actions">{access.write && <DeleteButton action={actions.deleteGroup} id={g.group_id} consequence={CONSEQUENCE.deleteGroup} size="xs" />}</td>
          </tr>
        ))}
        {groups.ok && rows.length === 0 && <tr><td colspan="4" class="empty">No groups yet. {access.write && <a href="/settings/groups/new" class="link">Create the first one</a>}.</td></tr>}
      </tbody>
    </table>
  </div>
</Layout>
