---
import { actions } from "astro:actions";
import Layout from "../layouts/Layout.astro";
import Field from "../components/Field.astro";
import MoneyField from "../components/MoneyField.astro";
import FormStatus from "../components/FormStatus.astro";
import { api, call, unreachableUrl } from "../api/client";
import { formState } from "../actions/run";
import { policyToFields, STACKING_POLICIES } from "../model/catalogue";
import { ROUNDING_POLICIES } from "../model/promotion";

const result = Astro.getActionResult(actions.putPolicy);
const current = await call(() => api.GET("/v1/policy"));
const state = formState(result?.data, current.ok ? policyToFields(current.data) : {});
---
<Layout title="Pricing policy" description="How every cart is priced: rounding, how promotions stack, and the most an order may be discounted." unreachable={unreachableUrl(current)}>
  <form method="post" action={actions.putPolicy} class="max-w-xl space-y-5">
    <section class="card space-y-4">
      <Field state={state} name="rounding" label="Rounding" options={ROUNDING_POLICIES} required hint="how a percentage discount is rounded to minor units" />
      <Field state={state} name="stacking" label="Stacking" options={STACKING_POLICIES} required hint="Sequential: each promotion sees the already discounted subtotal. Additive: all see the original." />
    </section>
    <section class="card space-y-4">
      <h2 class="card-title">Order cap <span class="hint inline font-normal">both empty = unconstrained</span></h2>
      <MoneyField state={state} name="order_cap.amount" label="At most this amount" />
      <Field state={state} name="order_cap.bps" label="At most this share, in basis points" type="number" hint="5000 = 50 % of the subtotal" />
    </section>
    <FormStatus state={state} />
    <div class="form-actions"><button type="submit" class="btn btn-primary">Save policy</button></div>
  </form>
</Layout>
