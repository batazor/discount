---
import Layout from "../../layouts/Layout.astro";
const q = Astro.url.searchParams.get("order_id")?.trim();
if (q) return Astro.redirect(`/redemptions/${encodeURIComponent(q)}`);
---
<Layout title="Redemptions" description="Look a stored redemption up by its order id to see what was priced, confirm it or cancel it.">
  <form method="get" class="flex max-w-md gap-2">
    <input type="text" name="order_id" placeholder="order_id" required class="input mono flex-1" />
    <button type="submit" class="btn btn-primary">Open</button>
  </form>
</Layout>
