---
import { actions } from "astro:actions";
import Layout from "../../layouts/Layout.astro";
import ApiError from "../../components/ApiError.astro";
import FormStatus from "../../components/FormStatus.astro";
import ResultPanel from "../../components/ResultPanel.astro";
import { api, call, unreachableUrl } from "../../api/client";
import { formState } from "../../actions/run";
import When from "../../components/When.astro";
import { CONSEQUENCE, REDEMPTION_STATUS_HELP } from "../../model/glossary";

const orderId = Astro.params.order_id!;
const confirmed = Astro.getActionResult(actions.confirmRedemption);
const cancelled = Astro.getActionResult(actions.cancelRedemption);
const transition = formState(confirmed?.data ?? cancelled?.data, {});
const current = await call(() => api.GET("/v1/redemptions/{order_id}", { params: { path: { order_id: orderId } } }));
const badge: Record<string, string> = { reserved: "badge-info", confirmed: "badge-ok", cancelled: "badge-muted" };
---
<Layout title={orderId} crumbs={[["Redemptions", "/redemptions"], [orderId]]} unreachable={unreachableUrl(current)}>
  <Fragment slot="badge">{current.ok && <span class={`badge ${badge[current.data.status]}`} data-tip={REDEMPTION_STATUS_HELP[current.data.status]}>{current.data.status}</span>}</Fragment>
  <Fragment slot="actions">
    {current.ok && (
      <>
        <a href={`/explain?order=${encodeURIComponent(orderId)}`} class="btn btn-secondary">Explain this order</a>
        <form method="post" action={actions.confirmRedemption}>
          <input type="hidden" name="id" value={orderId} />
          <button type="submit" class="btn btn-success" data-tip="reserved → confirmed: the order went through, budgets stay consumed">Confirm</button>
        </form>
        <form method="post" action={actions.cancelRedemption} onsubmit={`return confirm('Cancel ${orderId}? Budgets are restored.')`} data-confirm={CONSEQUENCE.cancelRedemption} data-confirm-title={`Cancel order ${orderId}?`} data-confirm-label="Cancel the redemption">
          <input type="hidden" name="id" value={orderId} />
          <button type="submit" class="btn btn-danger" data-tip="reserved or confirmed → cancelled: budgets and use counts are restored">Cancel</button>
        </form>
      </>
    )}
  </Fragment>
  {!current.ok && !current.unreachable && <ApiError status={current.status} body={current.body} traceId={current.traceId} />}
  {current.ok && (
    <div class="space-y-4">
      <FormStatus state={transition} okText={`Now ${current.data.status}.`} />
      <section class="card">
        <dl class="dl">
          <dt>Customer</dt>
          <dd>{current.data.customer_id ? <a href={`/customers/${encodeURIComponent(current.data.customer_id)}`} class="link">{current.data.customer_id}</a> : "—"}</dd>
          <dt>Created</dt><dd><When ts={current.data.created_at} /></dd>
          <dt>Updated</dt><dd><When ts={current.data.updated_at} /></dd>
        </dl>
      </section>
      <ResultPanel result={current.data.result} />
      <details><summary class="hint">Replayable pricing input</summary><pre class="card mt-2 overflow-x-auto text-[12px]">{JSON.stringify(current.data.input, null, 2)}</pre></details>
    </div>
  )}
  <p class="mt-6"><a href="/redemptions" class="btn btn-secondary">Look up another order</a></p>
</Layout>
